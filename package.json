{
  "name": "nexusbid-api",
  "version": "1.0.0",
  "description": "RFPNexa â€” USA Government RFP/Tender Marketplace REST API",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec tsx src/config/server.ts",
    "start": "node dist/config/server.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --watch --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:write": "prettier --write './src/**/*.{ts,js}'",
    "format": "prettier --check './src/**/*.{ts,js}'",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage --detectOpenHandles",
    "test:ci": "jest --ci --coverage --runInBand",
    "deps:unused": "knip",
    "deps:circular": "madge --circular --extensions ts src",
    "deps:graph": "dependency-cruiser src",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create -d src/config/database.ts",
    "migration:create:local": "cross-env NODE_ENV=local npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/database.ts ",
    "migration:generate:local": "cross-env NODE_ENV=local npm run typeorm -- migration:generate -d src/config/database.ts ",
    "migration:run": "cross-env NODE_ENV=local npm run typeorm -- migration:run -d src/config/database.ts",
    "migration:run:local": "cross-env NODE_ENV=local npm run migration:run",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/config/database.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/database.ts",
    "migration:revert:local": "cross-env NODE_ENV=local npm run typeorm -- migration:revert -d src/config/database.ts",
    "migration:revert:prod": "cross-env NODE_ENV=prod npm run typeorm -- migration:revert -d src/config/database.ts",
    "db:reset:local": "cross-env NODE_ENV=local npm run typeorm -- schema:drop -d src/config/database.ts && npm run migration:run:local && npm run seed:local",
    "seed": "tsx src/database/seeds/seed.ts",
    "seed:local": "cross-env NODE_ENV=local tsx src/database/seeds/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "pre-commit": "lint-staged",
    "prebuild": "rimraf dist",
    "preinstall": "",
    "prepare": "husky",
    "fake": "cross-env NODE_ENV=local npx tsx src/database/generateMissingMigrations.ts",
    "generate:errors": "tsx ts-morph-script.ts",
    "dev:local": "cross-env NODE_ENV=local nodemon --exec tsx src/config/server.ts",
    "dev:dev": "cross-env NODE_ENV=dev nodemon --exec tsx src/config/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "seed:prod": "node dist/database/seeds/seed.js",
    "test:auth": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles tests/auth",
    "migration:run:test": "cross-env NODE_ENV=test tsx ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/client-sesv2": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csrf-csrf": "4.0.3",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "node-cron": "4.6.0",
    "pg": "8.23.0",
    "pidusage": "4.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "resend": "6.18.1",
    "slugify": "1.6.9",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@jest/types": "30.4.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.2.0",
    "@types/node-cron": "3.0.11",
    "@types/pidusage": "2.0.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript/typescript6": "^6.0.2",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "knip": "6.32.0",
    "lint-staged": "17.3.0",
    "madge": "8.0.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-morph": "28.0.0",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.11",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "typescript7": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "tsc --noEmit"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "test",
          "chore",
          "perf",
          "ci",
          "build",
          "revert"
        ]
      ],
      "subject-case": [
        2,
        "always",
        "lower-case"
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "subject-full-stop": [
        2,
        "never",
        "."
      ],
      "header-max-length": [
        2,
        "always",
        72
      ],
      "body-leading-blank": [
        1,
        "always"
      ],
      "body-max-line-length": [
        2,
        "always",
        100
      ],
      "footer-leading-blank": [
        1,
        "always"
      ]
    }
  }
}

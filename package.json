{
  "name": "rfpnexa-api",
  "version": "1.0.0",
  "description": "RFPNexa â€” USA Government RFP/Tender Marketplace REST API",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec tsx -- tsconfig tsconfig.app.json src/config/server.ts",
    "start": "node dist/config/server.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:watch": "tsc --noEmit -p tsconfig.app.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage --detectOpenHandles",
    "test:ci": "jest --ci --coverage --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.unit.config.ts --runInBand --detectOpenHandles",
    "test:unit:watch": "cross-env NODE_ENV=test jest --config jest.unit.config.ts --watch",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.integration.config.ts --runInBand --detectOpenHandles",
    "test:integration:coverage": "cross-env NODE_ENV=test jest --config jest.integration.config.ts --runInBand --coverage --detectOpenHandles",
    "test:api": "cross-env NODE_ENV=test jest --config jest.api.config.ts --runInBand --detectOpenHandles",
    "test:e2e": "cross-env NODE_ENV=test jest --config jest.e2e.config.ts --runInBand --detectOpenHandles",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:api && npm run test:e2e",
    "deps:unused": "knip",
    "deps:circular": "madge --circular --extensions ts src",
    "deps:graph": "dependency-cruiser src",
    "typeorm": "tsx --tsconfig tsconfig.app.json ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create -d src/config/database.ts",
    "migration:create:local": "cross-env NODE_ENV=local npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/database.ts ",
    "migration:generate:local": "cross-env NODE_ENV=local npm run typeorm -- migration:generate -d src/config/database.ts ",
    "migration:run": "cross-env NODE_ENV=local npm run typeorm -- migration:run -d src/config/database.ts",
    "migration:run:local": "cross-env NODE_ENV=local npm run migration:run",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/config/database.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/database.ts",
    "migration:revert:local": "cross-env NODE_ENV=local npm run typeorm -- migration:revert -d src/config/database.ts",
    "migration:revert:prod": "cross-env NODE_ENV=prod npm run typeorm -- migration:revert -d src/config/database.ts",
    "db:reset:local": "cross-env NODE_ENV=local npm run typeorm -- schema:drop -d src/config/database.ts && npm run migration:run:local && npm run seed:local",
    "seed": "tsx --tsconfig tsconfig.app.json src/database/seeds/seed.ts",
    "seed:local": "cross-env NODE_ENV=local tsx --tsconfig tsconfig.app.json src/database/seeds/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "pre-commit": "lint-staged",
    "prebuild": "rimraf dist",
    "preinstall": "",
    "prepare": "husky",
    "generate:errors": "tsx --tsconfig tsconfig.app.json ts-morph-script.ts",
    "dev:local": "cross-env NODE_ENV=local nodemon --exec tsx --tsconfig tsconfig.app.json src/config/server.ts",
    "dev:dev": "cross-env NODE_ENV=dev nodemon --exec tsx --tsconfig tsconfig.app.json src/config/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "seed:prod": "node dist/database/seeds/seed.js",
    "migration:run:test": "cross-env NODE_ENV=test tsx --tsconfig tsconfig.app.json ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/client-sesv2": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csrf-csrf": "4.0.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.13.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "slugify": "1.6.9",
    "typeorm": "1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@jest/types": "30.4.1",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "26.2.0",
    "@types/node-cron": "3.0.11",
    "@types/pg": "^8.11.10",
    "@types/pidusage": "2.0.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "knip": "6.32.0",
    "lint-staged": "17.3.0",
    "madge": "^8.0.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "29.4.12",
    "ts-morph": "28.0.0",
    "tsc-alias": "1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.23.11",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "tsc --noEmit"
    ]
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["jest", "node"],
    "noEmit": true,
    "declaration": false,
    "resolvePackageJsonExports": false,
    "resolvePackageJsonImports": false
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "tests/**/*.ts",
    "./jest.api.config.ts",
    "./jest.config.ts",
    "./jest.e2e.config.ts",
    "./jest.integration.config.ts",
    "./jest.unit.config.ts",
    "./jest.shared.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

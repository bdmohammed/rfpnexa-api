# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=local
APP_NAME=rfpnexa
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
PORT=3000

# Express trust proxy config — use ONE of these, not both with conflicting values.
# TRUST_PROXY_HOPS: number of hops to trust (0 = disabled)
# TRUST_PROXY: 'true' | 'false' | number | string (IP/subnet) — 0 is treated as unset/default
TRUST_PROXY_HOPS=0
TRUST_PROXY=false

FRONTEND_CUSTOMER_URL=http://localhost:3001
FRONTEND_ADMIN_URL=http://localhost:3002

# true | false — set true only when running inside Docker
DOCKER=false


# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfpnexa-test

# PostgreSQL SSL
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Required in prod unless relying on system-trusted CA bundle (e.g. managed Postgres provider)
DATABASE_CA_CERT=

# Connection pool / query monitoring
DATABASE_SLOW_QUERY_THRESHOLD=1000
DATABASE_POOL_MAX=10

# NEVER enable this in production.
# When enabled, query parameters may be logged after sanitization.
DATABASE_LOG_PARAMETERS=false


# ─── JWT & Session ───────────────────────────────────────────────────────────
# Generate with:
#   openssl rand -hex 64
#
# Minimum: 64 characters
JWT_SECRET=replace-with-at-least-64-character-random-secret
JWT_ISSUER=rfpnexa-api
JWT_AUDIENCE=rfpnexa-client

# Generate with:
#   openssl rand -hex 32
#
# Minimum: 32 characters
CSRF_SECRET=replace-with-at-least-32-character-random-secret
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
CAPTCHA_REQUIRED_THRESHOLD=3
PASSWORD_RESET_MIN_INTERVAL_SECONDS=60

# ─── Geolocation & Telemetry ─────────────────────────────────────────────
GEOLOCATION_ENABLED=true
# ipapi | disabled | local
GEOLOCATION_PROVIDER=ipapi
GEOLOCATION_API_URL=https://ipapi.co/{ip}/json/
GEOLOCATION_TIMEOUT_MS=2000

# ─── PayPal ─────────────────────────────────────────────────────────────────
PAYPAL_ENV=sandbox

# Required when PayPal integration is enabled.
# Required in production.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Get from:
# PayPal Developer Dashboard → Webhooks
# Required in production.
PAYPAL_WEBHOOK_ID=


# ─── AWS S3 ─────────────────────────────────────────────────────────────────
#
# On EC2 with an attached IAM role:
# DO NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.
# The AWS SDK automatically uses the IAM role through IMDS.
#
# For local development without an IAM role:
# Prefer AWS SSO / named profiles (~/.aws/credentials)
# instead of storing long-lived credentials in .env.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=


# ─── Email ───────────────────────────────────────────────────────────────────
# Available:
#   dummy
#   resend
#   ses
EMAIL_PROVIDER=dummy

FROM_EMAIL=noreply@yourdomain.com
RFPNEXA_SYSTEM_ADMIN_EMAIL=admin@yourdomain.com

# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=


# ─── API ────────────────────────────────────────────────────────────────────
API_URL=http://localhost:3000


# ─── OAuth ──────────────────────────────────────────────────────────────────
#
# Client ID and Client Secret must be provided together.
# Leave both empty if the provider is not enabled.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# ─── Cloudflare Turnstile ───────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=


# ─── Features ───────────────────────────────────────────────────────────────
# Must remain false in production.
SWAGGER_ENABLED=false


# ─── Database Seed ───────────────────────────────────────────────────────────
#
# Used by:
#   npm run seed
#
# Creates the initial Super Admin when no Super Admin exists.
#
# IMPORTANT:
# Do not use the example password in any real environment.
#
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=superadmin@yourdomain.com
SEED_ADMIN_PASSWORD=ChangeMe123!Strong


# ─── PM2 Cluster ─────────────────────────────────────────────────────────────
#
# DO NOT SET MANUALLY.
# PM2 sets NODE_APP_INSTANCE automatically for each worker.
#
NODE_APP_INSTANCE=0

# ─────────────────────────────────────────────────────────────────────────────
# Production Dockerfile — Optimized Two-Stage Build
#
# Stage 1 (builder): Install build tools, cache npm dependencies, compile
#                    TypeScript, resolve @/* path aliases via tsc-alias,
#                    and emit clean JS to dist/.
# Stage 2 (runner):  Lean Alpine base, install ONLY production dependencies,
#                    copy compiled dist/, run as non-root user (UID 1001).
#
# Features:
#   - Zero devDependencies in runner image
#   - Zero duplicate cross-stage node_modules copies (eliminates ENOSPC crash)
#   - BuildKit cache mounts (ephemeral ~/.npm, not baked into image layers)
#   - Correct PID 1 signal forwarding with dumb-init
#   - Memory capped old-space-size for small EC2 instances
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:24-alpine AS builder

WORKDIR /app

# Copy dependency specifications and configs
COPY package*.json ./
COPY tsconfig*.json ./

# Cache mount ensures ~/.npm is persisted across builds without bloating layers
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps

# Copy application source code
COPY src ./src

# Compile TypeScript and rewrite @/* aliases to relative paths
RUN npm run build


# ── Stage 2: runner (final production image) ──────────────────────────────────
FROM node:24-alpine AS runner

ARG BUILD_DATE=""
ARG GIT_REVISION=""
ARG VERSION="1.0.0"

LABEL org.opencontainers.image.title="RFPNexa API" \
    org.opencontainers.image.description="RFPNexa — USA Government RFP/Tender Marketplace REST API" \
    org.opencontainers.image.authors="RFPNexa Team" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.revision="${GIT_REVISION}" \
    org.opencontainers.image.base.name="docker.io/library/node:24-alpine"

# Lightweight init system (PID 1)
RUN apk add --no-cache dumb-init

ENV TZ=UTC \
    NODE_ENV=prod \
    NODE_OPTIONS="--max-old-space-size=384"

# Create non-root user and app directory with explicit ownership
RUN addgroup --system --gid 1001 nexusbid && \
    adduser  --system --uid 1001 --ingroup nexusbid --no-create-home nexusbid && \
    mkdir -p /app && \
    chown -R nexusbid:nexusbid /app

WORKDIR /app

# Switch to non-root user BEFORE npm ci so all created files are natively owned by nexusbid.
# This completely eliminates the need for an expensive "RUN chown -R" layer!
USER nexusbid

COPY --chown=nexusbid:nexusbid package*.json ./

# Install production dependencies only (no TypeScript, Jest, ESLint, SWC, etc.)
RUN --mount=type=cache,target=/home/nexusbid/.npm,uid=1001,gid=1001 \
    npm ci --omit=dev --legacy-peer-deps --ignore-scripts

# Copy compiled JavaScript output from builder
COPY --chown=nexusbid:nexusbid --from=builder /app/dist ./dist

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/v1/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/config/server.js"]
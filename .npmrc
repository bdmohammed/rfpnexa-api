# eslint-plugin-import@2.x declares peer eslint@"^2-9" but this project uses
# eslint@10. This flag allows npm to install without erroring on that conflict.
# Safe: ESLint tooling is a devDependency and never ships to production.
legacy-peer-deps=true

# Ensure consistent, reproducible installs across machines/CI
engine-strict=true
save-exact=false

# Faster installs, avoids redundant network calls for already-cached packages
prefer-offline=false
fund=false
audit=false

# Avoid peer dependency install prompts hanging in CI
audit-level=high

# ─────────────────────────────────────────────────────────────────────────────
# .npmrc — Project-level npm configuration
# ─────────────────────────────────────────────────────────────────────────────

# eslint-plugin-import@2.x declares peer eslint@"^2-9" but this project uses
# eslint@10. This flag allows npm to install without erroring on that conflict.
# Safe: ESLint tooling is a devDependency and never ships to production.
legacy-peer-deps=true
